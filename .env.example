# Backend API origin (no trailing slash). Used by src/config/env.js → src/api/client.js
VITE_API_BASE_URL=http://localhost:8000

# Local-development pipeline toggle (src/config/env.js → src/api/runs.js).
# When true (or unset — default is true), createRun() uploads fixed files from
# public/dev/ instead of the user's Maxilla/Mandible scans.
# Set to false to upload real user scans (production createRun path).
# VITE_USE_LOCAL_DEV_PIPELINE=true
