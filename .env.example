# Backend API origin (no trailing slash). Used by src/config/env.js → src/api/client.js
VITE_API_BASE_URL=http://localhost:8000

# Local Development Mode (src/config/env.js → src/api/runs.js).
# Explicit opt-in for developers on machines WITHOUT the required AI license.
# When true, createRun() uploads fixed files from public/dev/ instead of the
# user's Maxilla/Mandible scans.
#
# Default when unset: Production Mode (false) — real user scans are uploaded.
# Client deployments and licensed developer machines should leave this unset
# or set it to false.
# Unlicensed developers only: uncomment the next line to enable local-dev samples.
# VITE_USE_LOCAL_DEV_PIPELINE=true
